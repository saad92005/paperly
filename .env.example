# Copy to .env (make setup does this) and fill in. Never commit .env.
# Stack: Neon Postgres + Better Auth, no Docker (docs/DECISIONS.md ADR-007).

# Core
APP_ENV=dev
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Database: Neon free Postgres (console.neon.tech -> Connect). Use the POOLED connection string
# with the scheme changed to postgresql+asyncpg:// and the query string set to ?ssl=require
# (asyncpg rejects sslmode/channel_binding; the web app converts it back for node-postgres).
DATABASE_URL=

# Auth: Better Auth runs inside the web app (ADR-007).
# BETTER_AUTH_SECRET: any random 32+ chars, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
BETTER_AUTH_SECRET=
# Optional Google sign-in (Google Cloud console OAuth client; redirect URI
# http://localhost:3000/api/auth/callback/google). Set NEXT_PUBLIC_AUTH_GOOGLE=1 to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=0
# The API verifies Better Auth JWTs; these default to WEB_BASE_URL-based values.
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=paperly-api

# Email (magic links). Empty = links are printed in the `make dev` console.
RESEND_API_KEY=
EMAIL_FROM=

# Web (public values only - these reach the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Providers (order = fallback order). Phase 0 ships stubs only.
LLM_PROVIDER_IMPL=openai_compat
ROUTE_CHAT=groq,gemini,openrouter
ROUTE_SUMMARY=gemini,groq
ROUTE_VISION=gemini
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# stub | fastembed | gemini
EMBEDDINGS_PROVIDER=fastembed
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384
# stub | flashrank
RERANKER=flashrank
PDF_PARSER_CHAIN=arxiv_html,grobid,pdfplumber
# empty = skip GROBID
GROBID_URL=

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES_FREE=100
QUOTA_QUESTIONS_PER_DAY=50
QUOTA_IMPORTS_PER_DAY=10
QUOTA_COMPARES_PER_DAY=5
WORKER_MODE=inprocess
WORKER_CONCURRENCY=2

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
# used in polite User-Agent for arXiv/Crossref/Unpaywall
CONTACT_EMAIL=
