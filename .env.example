# Copy to .env (make setup does this) and fill in. Never commit .env.
# Dev uses a free cloud Supabase project instead of the Docker stack (docs/DECISIONS.md ADR-004).

# Core
APP_ENV=dev
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Supabase (Dashboard -> Project Settings -> API / Database)
# DATABASE_URL: Connect -> "Session pooler" URI, with the scheme changed to postgresql+asyncpg://
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# server only, never in web
SUPABASE_SERVICE_ROLE_KEY=

# Web (public values only - these reach the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Providers (order = fallback order). Phase 0 ships stubs only.
LLM_PROVIDER_IMPL=stub
ROUTE_CHAT=groq,gemini,openrouter
ROUTE_SUMMARY=gemini,groq
ROUTE_VISION=gemini
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# stub | fastembed | gemini
EMBEDDINGS_PROVIDER=stub
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_DIM=384
# stub | flashrank
RERANKER=stub
PDF_PARSER_CHAIN=arxiv_html,grobid,pdfplumber
# empty = skip GROBID
GROBID_URL=

# Limits
MAX_UPLOAD_MB=25
MAX_PAGES_FREE=100
QUOTA_QUESTIONS_PER_DAY=50
QUOTA_IMPORTS_PER_DAY=10
QUOTA_COMPARES_PER_DAY=5
WORKER_MODE=inprocess
WORKER_CONCURRENCY=2

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
# used in polite User-Agent for arXiv/Crossref/Unpaywall
CONTACT_EMAIL=
